{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "v9-v8-panel-comparison-ledger.schema.v1",
  "title": "V9 V8 Panel Comparison Ledger",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "ledger_version",
    "fixture_id",
    "historical_transcript",
    "qualification_case_sha256",
    "run_id",
    "cost",
    "workflow_result",
    "historical_comparison",
    "enrichment_use",
    "human_disposition"
  ],
  "properties": {
    "ledger_version": { "const": 1 },
    "fixture_id": { "type": "string", "pattern": "^[A-G]$" },
    "historical_transcript": { "type": "string", "minLength": 1 },
    "qualification_case_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "run_id": { "type": "string", "minLength": 1 },
    "cost": {
      "type": "object",
      "additionalProperties": false,
      "required": ["count_only_maximum_usd", "actual_calculated_usd"],
      "properties": {
        "count_only_maximum_usd": { "type": "string" },
        "actual_calculated_usd": { "type": "string" }
      }
    },
    "workflow_result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["override_effect", "proof_status", "model_gate", "controller_disposition"],
      "properties": {
        "override_effect": { "type": "string" },
        "proof_status": { "type": "string" },
        "model_gate": { "type": "string" },
        "controller_disposition": { "type": "string" }
      }
    },
    "historical_comparison": {
      "type": "object",
      "additionalProperties": false,
      "required": ["experiment_selection", "prediction", "camera", "observability", "override_quality", "result_review"],
      "properties": {
        "experiment_selection": { "$ref": "#/$defs/comparison" },
        "prediction": { "$ref": "#/$defs/comparison" },
        "camera": { "$ref": "#/$defs/comparison" },
        "observability": { "$ref": "#/$defs/comparison" },
        "override_quality": { "$ref": "#/$defs/comparison" },
        "result_review": { "$ref": "#/$defs/comparison" }
      }
    },
    "enrichment_use": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["claim_or_decision", "support_class", "exact_refs", "assessment"],
        "properties": {
          "claim_or_decision": { "type": "string", "minLength": 1 },
          "support_class": {
            "enum": [
              "packet_v8_only",
              "enrichment_only",
              "controller_comparison_only",
              "packet_v8_and_enrichment",
              "packet_v8_and_controller_comparison",
              "all_three"
            ]
          },
          "exact_refs": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "assessment": { "type": "string", "minLength": 1 }
        }
      }
    },
    "human_disposition": {
      "enum": ["tentative_pass", "refine_and_repeat", "move_up_model_ladder", "pending"]
    }
  },
  "$defs": {
    "comparison": {
      "type": "object",
      "additionalProperties": false,
      "required": ["historical", "current", "assessment"],
      "properties": {
        "historical": { "type": "string" },
        "current": { "type": "string" },
        "assessment": { "enum": ["better", "comparable", "worse", "different", "not_applicable"] }
      }
    }
  }
}
